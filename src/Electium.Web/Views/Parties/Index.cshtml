@model IEnumerable<PartyViewModel>
@{
    ViewData["Title"] = "Partidos";
}

<div class="el-wrap">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <h1 class="el-title">Partidos políticos</h1>
            <p class="el-subtitle">Administra los partidos que presentan candidatos.</p>
        </div>
        <a class="btn btn-gold" asp-action="Create">+ Nuevo partido</a>
    </div>

    <div class="el-card">
        <div class="table-responsive">
            <table class="table tbl align-middle mb-0">
                <thead>
                    <tr><th>Partido</th><th>Descripción</th><th>Estado</th><th class="text-end">Acciones</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Name</td>
                            <td class="text-secondary">@(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)</td>
                            <td>
                                @if (item.IsActive) { <span class="badge text-bg-success">Activo</span> }
                                else { <span class="badge text-bg-secondary">Inactivo</span> }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                                          onsubmit="return confirm('¿Eliminar el partido @item.Name?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="4" class="text-center text-secondary py-5">Aún no hay partidos registrados.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
