@model IEnumerable<LeaderDto>
@{
    ViewData["Title"] = "Dirigentes políticos";
}

<div class="el-wrap">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <h1 class="el-title">Dirigentes políticos</h1>
            <p class="el-subtitle">Cuentas de acceso para los dirigentes de cada partido.</p>
        </div>
        <a class="btn btn-gold" asp-action="Create">+ Nuevo dirigente</a>
    </div>

    <div class="el-card">
        <div class="table-responsive">
            <table class="table tbl align-middle mb-0">
                <thead>
                    <tr><th>Nombre</th><th>Correo</th><th>Partido</th><th>Estado</th><th class="text-end">Acciones</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.FullName</td>
                            <td class="text-secondary">@item.Email</td>
                            <td>@item.PartyName</td>
                            <td>
                                @if (item.IsActive) { <span class="badge text-bg-success">Activo</span> }
                                else { <span class="badge text-bg-secondary">Desactivado</span> }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <form asp-action="SetActive" method="post">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="isActive" value="@((!item.IsActive).ToString().ToLowerInvariant())" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">@(item.IsActive ? "Desactivar" : "Activar")</button>
                                    </form>
                                    <form asp-action="Delete" method="post" onsubmit="return confirm('¿Eliminar a este dirigente?');">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center text-secondary py-5">Aún no hay dirigentes registrados.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
