@model CitizenViewModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Nuevo ciudadano" : "Editar ciudadano";
}

<div class="el-wrap" style="max-width:720px">
    <div class="mb-4">
        <h1 class="el-title">@ViewData["Title"]</h1>
        <p class="el-subtitle">El documento de identidad debe ser único en el registro.</p>
    </div>

    <div class="el-card">
        <div class="el-card-body">
            <form method="post" asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? (int?)null : Model.Id)" novalidate>
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-7">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" type="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="IdentityDocument" class="form-label"></label>
                        <input asp-for="IdentityDocument" class="form-control" placeholder="000-0000000-0" inputmode="numeric" maxlength="13" />
                        <span asp-validation-for="IdentityDocument" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>
                        <div class="form-text">Solo los ciudadanos activos pueden votar o ser candidatos.</div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
                    <button type="submit" class="btn btn-navy">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>
